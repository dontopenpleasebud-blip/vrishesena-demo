function search() {
  const search_icon = document.querySelector(".search_icon");
  const searchEl = document.querySelector(".search");
  const close_search = document.querySelector(".search_close");
  const body = document.querySelector('body');

  // Exit early if required elements don't exist on this page
  if (!search_icon || !searchEl || !close_search || !body) return;

  // Ensure the initial state is set on page load
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", () => {
      if (searchEl) {
        searchEl.classList.remove("search_active");
        body.style.overflow = "";
      }
    });
  } else {
    // DOM already loaded
    searchEl.classList.remove("search_active");
    body.style.overflow = "";
  }

  let searchImagesLoaded = false;
  search_icon.addEventListener("click", () => {
    if (searchEl) {
      searchEl.classList.add("search_active");
      body.style.overflow = "hidden";
      if (!searchImagesLoaded) {
        searchEl.querySelectorAll("img[data-src]").forEach(img => {
          img.src = img.dataset.src;
          img.removeAttribute("data-src");
        });
        searchImagesLoaded = true;
      }
    }
  });

  close_search.addEventListener("click", () => {
    if (searchEl) {
      searchEl.classList.remove("search_active");
      body.style.overflow = "";
    }
  });
}



function fussySearch() {
  const searchInput = document.querySelector(".search_input");
  const items = Array.from(document.querySelectorAll(".recent_tag li a")); // Get all anchor tags in the list
  const noResultsMessage = document.getElementById("no-results"); // "No results" message

  if (!searchInput || items.length === 0) return;

  // Prepare the data for Fuse.js (use the text content of each list item)
  const data = items.map((item) => ({
    title: item.textContent,
    element: item.closest("li"), // Store the list item (li) for easy reference
  }));

  // Fuse.js options
  const options = {
    includeScore: true,
    threshold: 0.6, // Adjust the threshold for fuzzy matching (lower = more accurate)
    keys: ["title"], // Search based on the title text
  };

  // Check if Fuse is available
  if (typeof Fuse === 'undefined') return;

  const fuse = new Fuse(data, options); // Create a new Fuse.js instance

  // Function to perform fuzzy search
  function fuzzySearch(query) {
    const results = fuse.search(query); // Get the search results

    // Hide all items first
    items.forEach((item) => (item.closest("li").style.display = "none"));

    // Show only the matching items
    results.forEach((result) => {
      result.item.element.style.display = ""; // Show matching item
    });

    // Show "No results" message if no results found
    if (noResultsMessage) {
      if (results.length === 0) {
        noResultsMessage.style.display = "block";
      } else {
        noResultsMessage.style.display = "none";
      }
    }
  }

  // Event listener for input field to perform search
  searchInput.addEventListener("input", function () {
    const query = searchInput.value;
    fuzzySearch(query);
  });
}



function megaMenu() {
  const causesList = document.querySelector(".causes_list");
  const megaMenu = document.querySelector(".mega_menu");

  if (causesList && megaMenu) {
    // Show mega menu on causes_list hover
    causesList.addEventListener("mouseenter", function () {
      megaMenu.style.visibility = "visible";
      megaMenu.style.opacity = "1";
    });

    // Hide mega menu when mouse leaves both causes_list and mega_menu
    causesList.addEventListener("mouseleave", function () {
      setTimeout(function () {
        if (!megaMenu.matches(":hover")) {
          megaMenu.style.visibility = "hidden";
          megaMenu.style.opacity = "0";
        }
      }, 100); // Small delay to allow hover on mega_menu
    });

    // Keep mega menu visible if mouse enters mega_menu
    megaMenu.addEventListener("mouseenter", function () {
      megaMenu.style.visibility = "visible";
      megaMenu.style.opacity = "1";
    });

    // Hide mega menu when mouse leaves mega_menu
    megaMenu.addEventListener("mouseleave", function () {
      megaMenu.style.visibility = "hidden";
      megaMenu.style.opacity = "0";
    });
  }
}

function recentSearch() {
  const heartBtn = document.querySelector(".heart_icon");
  const recentNav = document.querySelector(".recently_view");
  const recentClose = document.querySelector(".recently_close");
  const body = document.querySelector("body");

  if (!heartBtn || !recentNav || !recentClose) return;

  const overlay = document.createElement("div");
  overlay.classList.add("body_overlay");

  heartBtn.addEventListener("click", () => {
    recentNav.classList.add("recently_view_active");
    body.appendChild(overlay); // Add overlay to body
    body.style.overflow = "hidden"; // Disable scroll
  });

  recentClose.addEventListener("click", () => {
    recentNav.classList.remove("recently_view_active");
    if (document.querySelector(".body_overlay")) {
      overlay.remove(); // Remove overlay
    }
    body.style.overflow = ""; // Enable scroll
  });
}


function categoryFilter() {
  // Get all category list elements
  const categoryLists = document.querySelectorAll(".category_list");

  // Get all cards (col-3 elements)
  const cards = document.querySelectorAll(".category_card");

  // Only run on pages that have cards with the "causes" class (main causes/index page)
  if (categoryLists.length === 0 || cards.length === 0) return;
  const hasCausesCards = Array.from(cards).some(card => card.classList.contains("causes"));
  if (!hasCausesCards) return;

  // Function to scroll to card_category section plus offset
  const scrollToCardSection = (offset = 0) => {
    const cardSection = document.querySelector(".card_category");
    if (cardSection) {
      const cardSectionPosition = cardSection.getBoundingClientRect().top + window.pageYOffset;
      window.scrollTo({
        top: cardSectionPosition - offset,
        behavior: 'smooth'
      });
    }
  };

  // Initially display only cards with the "causes" class
  cards.forEach((card) => {
    card.style.display = card.classList.contains("causes") ? "block" : "none";
  });

  // Add click event listener to each category list
  categoryLists.forEach((category) => {
    category.addEventListener("click", function () {
      // Remove 'acitve_category' class from all categories
      categoryLists.forEach((cat) => {
        cat.classList.remove("acitve_category");
      });

      // Add 'acitve_category' class to the clicked category
      this.classList.add("acitve_category");

      // Get the text of the clicked category (lowercase for matching)
      const selectedCategory = this.textContent.trim().toLowerCase();

      // Filter cards based on selected category
      cards.forEach((card) => {
        // For 'All' category, show only cards with the "causes" class
        if (selectedCategory === "all") {
          card.style.display = card.classList.contains("causes") ? "block" : "none";
        } else {
          // Check if the card has a class matching the selected category
          card.style.display = card.classList.contains(selectedCategory) ? "block" : "none";
        }
      });
    });
  });

  // Add click event listener to "Donate Now" buttons
  const donateButtons = document.querySelectorAll(".donate_now");
  donateButtons.forEach((button) => {
    button.addEventListener("click", function () {
      // Get the category from the button's data-category attribute
      const selectedCategory = this.getAttribute("data-category");

      // Remove 'acitve_category' class from all categories
      categoryLists.forEach((cat) => {
        cat.classList.remove("acitve_category");
      });

      // Add 'acitve_category' class to the corresponding category
      const targetCategory = Array.from(categoryLists).find(
        (category) => category.textContent.trim().toLowerCase() === selectedCategory
      );

      if (targetCategory) {
        targetCategory.classList.add("acitve_category");
      }

      // Filter cards based on selected category
      cards.forEach((card) => {
        if (selectedCategory === "all") {
          card.style.display = card.classList.contains("causes") ? "block" : "none";
        } else {
          card.style.display = card.classList.contains(selectedCategory) ? "block" : "none";
        }
      });

      // Scroll to card section with 20px offset
      scrollToCardSection(40);
    });
  });
}


function toggleNavOnScroll(navSelector) {
  let lastScrollTop = 0;

  window.addEventListener("scroll", () => {
    // Apply scroll behavior only if screen width is <= 767px
    if (window.innerWidth <= 767) {
      const recentNav = document.querySelector(navSelector);
      if (!recentNav) return;

      const currentScrollTop = window.scrollY;

      if (currentScrollTop > lastScrollTop) {
        // Scrolling down - show the div
        recentNav.style.transform = "translateY(0)";
      } else {
        // Scrolling up - hide the div
        recentNav.style.transform = "translateY(100%)";
      }

      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop; // Prevent negative scroll values
    } else {
      // Reset transform if screen width is greater than 767px
      const recentNav = document.querySelector(navSelector);
      if (recentNav) {
        recentNav.style.transform = "translateY(0)"; // Always visible for larger screens
      }
    }
  });
}


