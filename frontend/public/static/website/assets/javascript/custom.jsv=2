function blogPage() {
  const images = document.querySelectorAll(".image_section img");
  const contents = document.querySelectorAll(".inner_content_section");

  function showContent(contentId) {
    // Hide all content sections
    contents.forEach((content) => {
      content.classList.remove("active");
    });

    // Show the relevant content section
    const activeContent = document.getElementById(contentId);
    if (activeContent) {
      activeContent.classList.add("active");
    }
  }

  function handleImageInteraction(event) {
    const contentId = `content_${event.currentTarget.id.split("_")[1]}`;
    showContent(contentId);
  }

  images.forEach((image) => {
    image.addEventListener("mouseover", handleImageInteraction);
    image.addEventListener("click", handleImageInteraction); // For mobile interaction
  });
}

function galleryContainer() {
  const categories = document.querySelectorAll(".gallery_category_list");
  const allImages = document.querySelectorAll(".gallery_row .col-xl-3"); // All gallery items

  categories.forEach((category) => {
    category.addEventListener("click", () => {
      // Remove the active class from all categories
      categories.forEach((cat) =>
        cat.classList.remove("gallery_category_list_active")
      );
      category.classList.add("gallery_category_list_active");

      // Get the category clicked
      const categoryName = category.textContent
        .trim()
        .toLowerCase()
        .replace(/ /g, "_");

      // Show or hide gallery items based on category
      allImages.forEach((item) => {
        if (
          categoryName === "all_images" ||
          item.classList.contains(categoryName)
        ) {
          item.style.display = "block"; // Show item
        } else {
          item.style.display = "none"; // Hide item
        }
      });
    });
  });
}

