function mobileNav() {
  const mobileNav = document.querySelector(".mobile_nav");
  const menuBar = document.querySelector(".menubar");
  const topMenu = document.querySelector(".top_menu_line");
  const middleLine = document.querySelector(".middle_menu_line");
  const bottomLine = document.querySelector(".bottom_menu_line");
  const body = document.body;

  if (!menuBar || !mobileNav) return;

  menuBar.addEventListener("click", () => {
     console.log("menubar is clicked")
    mobileNav.classList.toggle("mobile_nav_active");
    if (topMenu) topMenu.classList.toggle("top_menu_line_active");
    if (middleLine) middleLine.classList.toggle("middle_menu_line_active");
    if (bottomLine) bottomLine.classList.toggle("bottom_menu_line_active");


    if (mobileNav.classList.contains("mobile_nav_active")) {
      body.style.overflow = "hidden"; // Disable body scrolling
      mobileNav.style.overflowY = "scroll"; // Enable scrolling in mobile_nav
    } else {
      body.style.overflow = ""; // Re-enable body scrolling
      mobileNav.style.overflowY = ""; // Reset mobile_nav overflow
    }
  });
}

