//script for counter in about and index  page
if (typeof $ !== 'undefined' && typeof $.fn !== 'undefined') {
  $(document).ready(function () {
    function animateCounter() {
      $('.counter').each(function () {
        const $this = $(this);
        const originalText = $this.text().trim();

        // Extract numeric part and suffix
        const numMatch = originalText.match(/[\d.,]+/);
        const number = numMatch ? parseFloat(numMatch[0].replace(/,/g, '')) : 0;

        const prefixMatch = originalText.match(/^[^0-9]*/); // e.g., "₹"
        const suffixMatch = originalText.match(/[^\d]+$/);  // e.g., " Cr+", " Lakhs+"

        const prefix = prefixMatch ? prefixMatch[0] : '';
        const suffix = suffixMatch ? suffixMatch[0].trim() : '';

        $({ countNum: 0 }).animate({ countNum: number }, {
          duration: 1000,
          easing: 'swing',
          step: function () {
            let val = this.countNum.toFixed(2);
            $this.text(`${prefix}${val} ${suffix}`);
          },
          complete: function () {
            let val = this.countNum.toFixed(2);
            $this.text(`${prefix}${val} ${suffix}`);
          }
        });
      });
    }

    animateCounter();
  });
}


function validateNames(input) {
    input.value = input.value.replace(/[^A-Za-z\s]/g, '');
}

function handlePastes(e) {
    e.preventDefault();
    let paste = (e.clipboardData || window.clipboardData).getData('text');
    paste = paste.replace(/[^A-Za-z\s]/g, '');
    document.getElementById('name').value += paste;
}

function handlePaste(e) {
    e.preventDefault();
    var paste = (e.clipboardData || window.clipboardData).getData('text');
    paste = paste.replace(/[\uD83C-\uDBFF\uDC00-\uDFFF]/g, '').replace(/[-.<>?{}#]/g, '');
    var target = e.target || e.srcElement;
    if (target) target.value += paste;
}

function validateInput(element) {
    // This regex now correctly blocks emojis and specified special characters: "-", ".", "<", ">", "?", "{", "}", and "#"
    element.value = element.value.replace(/[\uD83C-\uDBFF\uDC00-\uDFFF]/g, '') // Block Emojis
                                .replace(/[-.<>?{}#]/g, ''); // Block the specific characters
}

function validatePaste(e) {
    e.preventDefault(); // Prevent default paste action
    const pastedText = (e.clipboardData || window.clipboardData).getData('text');
    // Block emojis and the specific characters during paste as well
    const filteredText = pastedText.replace(/[\uD83C-\uDBFF\uDC00-\uDFFF]/g, '')
                                   .replace(/[-.<>?{}#]/g, '');
    document.getElementById('donorParcel').value += filteredText;
}