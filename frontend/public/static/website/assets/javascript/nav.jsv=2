// OTP input validation - only attach if element exists on the page
(function() {
    const otpInputEl = document.getElementById('otpInput');
    if (otpInputEl) {
        otpInputEl.addEventListener('input', function(e) {
            let value = this.value.replace(/\D/g, '');
            value = value.slice(0, 6);
            this.value = value;
        });

        otpInputEl.addEventListener('keydown', function(e) {
            if (e.key === 'e' || e.key === '-' || e.key === '+' || e.key === '.') {
                e.preventDefault();
            }
        });

        otpInputEl.addEventListener('paste', function(e) {
            e.preventDefault();
            const pastedText = (e.clipboardData || window.clipboardData).getData('text');
            const numericValue = pastedText.replace(/\D/g, '').slice(0, 6);
            this.value = numericValue;
        });
    }
})();